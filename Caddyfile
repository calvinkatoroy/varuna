{
	email {$CADDY_EMAIL}
}

# Public plane. On a real domain Caddy auto-issues a Let's Encrypt cert; on localhost it uses
# its internal CA. Upstreams are Docker Compose service names (added to compose at deploy).
{$VARUNA_DOMAIN} {
	# Agent API (per-agent bearer token, agent-initiated polling)
	handle /agent/* {
		reverse_proxy api-agent:8001
	}

	# Public browser API (JWT, Pydantic-validated)
	handle /api/* {
		reverse_proxy api-public:8000
	}

	# Agent installer bundle (public: install.ps1 + agent-bundle.zip)
	handle /dist/* {
		root * /srv
		file_server
	}

	# React single-page app: fall back to index.html for client-side routing
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}

	# Security headers (defense in depth for the SPA + API)
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}

# Team plane (NFR-24): the same SPA, but /api goes to the PRIVATE API. Served on its own port,
# which compose publishes only on the host's Tailscale address, and which the public tunnel never
# targets (it points at :80). Same origin for page and API: no CORS, no mixed content.
:8080 {
	handle /api/* {
		reverse_proxy api-private:8010
	}
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}

# The private-plane API (findings, manual input, full reports) is NOT served on the public site above. It binds
# only to the host's Tailscale interface (NFR-24, private_api.py) with no public listener,
# reachable from tailnet devices at http://<tailscale-host>:8010.
