# Copy to .env and set the values. Local dev defaults mostly work, but JWT_SECRET is required.

# --- domain / TLS ---
# The control-plane domain. localhost for local dev; the real delegated domain on the VM (TBD-4).
VARUNA_DOMAIN=localhost
# Email for Let's Encrypt (real domain only; ignored on localhost).
CADDY_EMAIL=admin@example.com

# --- security (REQUIRED in production) ---
# Secret that signs browser JWTs. MUST be a long random value: openssl rand -hex 32
JWT_SECRET=CHANGE-ME-to-a-long-random-string
# Origins allowed to call the APIs (the SPA's URL). Comma-separated. Testing the frontend
# host-run against these APIs (VITE_MOCK=0, `npm run dev`, no Caddy) means the origin is the
# Vite dev server, not this default - add http://localhost:5173 or requests get CORS-blocked
# before you see anything else, e.g.: VARUNA_CORS_ORIGINS=https://localhost,http://localhost:5173
VARUNA_CORS_ORIGINS=https://localhost

# --- private plane (Tailscale, NFR-24) ---
# Host IP the private API binds to. Set to the VM's Tailscale IP in prod so findings/reports
# have NO public listener. Defaults to loopback for local dev.
TAILSCALE_BIND=127.0.0.1
# URL the SPA uses to reach the private API (baked into the frontend build). In prod this is
# the Tailscale host, e.g. http://100.x.y.z:8010 or a MagicDNS name.
VITE_PRIVATE_API=http://localhost:8010

# --- internal services (rarely changed) ---
OLLAMA_MODEL=qwen2.5:7b
SCAN_TTL_SECONDS=86400

# --- go-public (IdeaPad self-host via Tailscale Funnel) ---
# Ollama runs NATIVE on the Windows host (GPU). Containers reach it via the Docker host gateway.
# OLLAMA_URL=http://host.docker.internal:11434
# VARUNA_DOMAIN / VARUNA_CORS_ORIGINS use the Tailscale Funnel hostname, e.g. kalpinoos.tailXXXX.ts.net

# --- host-run local dev only (Compose sets these itself via service DNS names) ---
# Uncomment and point at your own throwaway Redis/Ollama when running uvicorn directly on
# the host instead of via docker-compose. Loaded automatically (python-dotenv), no need to
# export/`$env:` these by hand in every terminal.
# REDIS_URL=redis://localhost:6379/0
# OLLAMA_URL=http://localhost:11434
# VARUNA_URL=http://localhost:8001  # agent.py: base URL for the agent API

# Public-plane API refuses security-team logins (they sign in on the private plane, NFR-24).
# Set to 1 only for local dev with no private plane.
# VARUNA_PUBLIC_TEAM_LOGIN=0
