# Copy to .env and adjust. Local dev defaults work as-is.

# Control-plane domain. localhost for local dev; the real delegated domain on the VM (TBD-4).
VARUNA_DOMAIN=localhost
# Email for Let's Encrypt (real domain only; ignored on localhost).
CADDY_EMAIL=admin@example.com

# Redis, internal to vapt-net (NFR-9). Not published externally.
REDIS_URL=redis://redis:6379/0

# Ollama, internal to vapt-net. Enrichment model (C-1).
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

# Scan-data TTL in seconds (24h, C-5). Accounts/agents/audit are exempt (NFR-27).
SCAN_TTL_SECONDS=86400
